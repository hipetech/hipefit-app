{
  "name": "hipefit-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@latest",
  "scripts": {
    "start": "expo start",
    "open:xcode": "xed ios",
    "ios:development": "cp .env.development .env.local && expo run:ios --scheme Hipefit-dev",
    "ios:staging": "cp .env.staging .env.local && expo run:ios --scheme Hipefit-stage",
    "ios:production": "cp .env.production .env.local && expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "db:seed": "bun run scripts/db/index.ts",
    "db:wipe": "bun run scripts/db/wipe.ts"
  },
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@hipefit/expandable-accessory": "workspace:*",
    "@hipefit/navigation-dock": "workspace:*",
    "@legendapp/list": "^3.3.3",
    "@marceloterreiro/flash-calendar": "2.0.0",
    "@react-native-firebase/ai": "25.1.0",
    "@react-native-firebase/analytics": "25.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/crashlytics": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^22",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "sf-symbols-typescript": "^2.1.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
