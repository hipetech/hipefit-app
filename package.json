{
  "name": "hipefit-workspace",
  "version": "1.0.0",
  "packageManager": "bun@latest",
  "scripts": {
    "start": "bun run --filter @hipefit/mobile start",
    "open:xcode": "bun run --filter @hipefit/mobile open:xcode",
    "ios:development": "bun run --filter @hipefit/mobile ios:development",
    "ios:staging": "bun run --filter @hipefit/mobile ios:staging",
    "ios:production": "bun run --filter @hipefit/mobile ios:production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "bun run --filter @hipefit/mobile type-check && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "db:seed": "bun run firebase/seed/index.ts",
    "db:wipe": "bun run firebase/seed/wipe.ts",
    "db:migrate": "bun run firebase/migrations/migrate.ts",
    "firebase": "bun run scripts/firebase/run.ts"
  },
  "dependencies": {
    "@hipefit/schemas": "workspace:*",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@hipefit/config": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "15.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
