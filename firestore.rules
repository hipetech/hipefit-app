rules_version = '1';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Global exercises (read-only for authenticated users) ─────────────
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Global exercise groups (read-only for authenticated users) ───────
    match /exerciseGroups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── User profile ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ─── User exercise groups ────────────────────────────────────────
      match /exerciseGroups/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Exercise overrides ──────────────────────────────────────────
      match /exerciseOverrides/{exerciseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Custom exercises ────────────────────────────────────────────
      match /customExercises/{exerciseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Routines ───────────────────────────────────────────────────
      match /routines/{routineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Workouts ───────────────────────────────────────────────────
      match /workouts/{workoutId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Exercise history (immutable: create + delete only) ─────────
      match /exerciseHistory/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }
  }
}
