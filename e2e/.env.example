# Test user created by hand in the hipefit-app-dev Firebase project (Email/Password provider).
MAESTRO_E2E_EMAIL=
MAESTRO_E2E_PASSWORD=

# Optional. UDID of the simulator to test; required when more than one is booted.
E2E_DEVICE=
# Optional. Metro port for the preflight check; a worktree run does not use 8081.
RCT_METRO_PORT=
